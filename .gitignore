# Ignores for the standalone ruleofthumb repo.
# Note: the built docs site in docs/ IS committed (Pages serves this
# branch's /docs folder); only the staged notebook copies are generated.
dist/
build/
*.egg-info/
src/*.egg-info/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
# local credentials (never commit)
.pypirc
.readthedocs_api_key
# staged notebook copies (generated; see PUBLISH.md one-command docs build)
docs-src/notebooks/
# external human-annotation data (gitignored cache; see fetch_external.py)
tests/integration/external_cache/
# sphinx build output + notebook execution cache (never committed; RTD builds its own)
docs-src/_build/
.jupyter_cache/
.cache/
.DS_Store

# share-weights experiment outputs: figures and raw importances are regenerated, not committed
tests/integration/artifacts/share_weights_results/*/saliency/
tests/integration/artifacts/share_weights_results/*/importances_*.npy
