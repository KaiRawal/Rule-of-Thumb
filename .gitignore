# Ignores for the standalone ruleofthumb repo.
# Note: the built docs site in docs/ IS committed (Pages serves this
# branch's /docs folder); only the staged notebook copies are generated.
dist/
build/
*.egg-info/
src/*.egg-info/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
# local credentials (never commit)
.pypirc
.readthedocs_api_key
# staged notebook copies (generated; see PUBLISH.md one-command docs build)
docs-src/notebooks/
# sphinx build output + notebook execution cache (never committed; RTD builds its own)
docs-src/_build/
.jupyter_cache/
.cache/
